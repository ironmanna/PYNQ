#!/bin/sh
# pynq-network-autoip
#
# Pick a static IPv4 address for eth0 on the 192.168.2.0/24 PYNQ link,
# avoiding ARP conflicts when multiple boards share an L2 segment.
#
# Order of preference:
#   1. The address recorded in /var/lib/pynq-network/assigned-ip (sticky
#      across reboots), if it is still free on the wire.
#   2. 192.168.2.99 (classic PYNQ default).
#   3. 192.168.2.100 .. 192.168.2.110 (fallbacks).
#
# If a DHCP lease arrives first (carrier up, lease via /run/systemd/netif),
# we bail and let DHCP own the interface -- the shipped 10-eth0.network
# already requests one.
#
# Output: writes /run/systemd/network/05-eth0-autoip.network with the
# winning address. systemd-networkd picks this up because /run is searched
# before /etc, and "05-" sorts before the shipped "10-eth0.network".
#
# This script runs once at boot via pynq-network-autoip.service, before
# systemd-networkd starts. It is idempotent: re-running just refreshes the
# drop-in. Log lines go to journal (stderr) and to /etc/motd so the user
# sees the chosen IP on first login.

set -eu

IFACE="eth0"
SUBNET_PREFIX="192.168.2"
PREFIX_LEN="24"
GATEWAY=""                      # leave empty: PYNQ link is usually point-to-point
CANDIDATES="99 100 101 102 103 104 105 106 107 108 109 110"

STATE_DIR="/var/lib/pynq-network"
STATE_FILE="${STATE_DIR}/assigned-ip"
DROPIN_DIR="/run/systemd/network"
DROPIN_FILE="${DROPIN_DIR}/05-eth0-autoip.network"
MOTD_FRAG="/run/pynq-network-motd"

# arping -D timing: 1 probe, 1 second timeout. Worst case with 12 candidates
# all taken = 12s, but the .99 happy path is ~1s. arping is from iputils.
ARPING_TIMEOUT=1
ARPING_PROBES=1

log() {
    # journald captures stderr from oneshot units
    echo "pynq-network-autoip: $*" >&2
}

write_dropin() {
    ip="$1"
    mkdir -p "${DROPIN_DIR}"
    cat >"${DROPIN_FILE}" <<EOF
# Auto-generated by pynq-network-autoip. Do not edit by hand.
# Remove /var/lib/pynq-network/assigned-ip and reboot to force re-selection,
# or mask pynq-network-autoip.service to disable auto-IP entirely.
[Match]
Name=${IFACE}

[Network]
DHCP=ipv4
Address=${ip}/${PREFIX_LEN}
EOF
    chmod 0644 "${DROPIN_FILE}"
}

write_motd() {
    ip="$1"
    mkdir -p "$(dirname "${MOTD_FRAG}")"
    cat >"${MOTD_FRAG}" <<EOF

  PYNQ.remote: eth0 static IP = ${ip}/${PREFIX_LEN}
  (managed by pynq-network-autoip; state in ${STATE_FILE})

EOF
    # /etc/motd is a regular file; append if our marker isn't already there
    if ! grep -q "pynq-network-autoip" /etc/motd 2>/dev/null; then
        cat "${MOTD_FRAG}" >>/etc/motd || true
    else
        # Replace previous block (between PYNQ.remote and the blank line after)
        # Simple approach: rewrite /etc/motd without the old block, then append.
        if [ -f /etc/motd ]; then
            awk '
                /PYNQ\.remote: eth0 static IP/ { skip=1; next }
                skip && /pynq-network-autoip/ { next }
                skip && /^[[:space:]]*$/ { skip=0; next }
                skip { next }
                { print }
            ' /etc/motd >/etc/motd.tmp && mv /etc/motd.tmp /etc/motd
        fi
        cat "${MOTD_FRAG}" >>/etc/motd || true
    fi
}

print_console() {
    ip="$1"
    # /dev/console may not exist in some containers; ignore failures.
    msg="[pynq-network-autoip] eth0 = ${ip}/${PREFIX_LEN}"
    echo "${msg}" >/dev/console 2>/dev/null || true
    log "${msg}"
}

bring_iface_up() {
    # Need link up for ARP probes. Don't assign an address yet -- that's
    # systemd-networkd's job once we've written the drop-in.
    ip link set "${IFACE}" up 2>/dev/null || true
    # Wait briefly for carrier; if there's no cable, autoip is pointless
    # but we still want to write *some* drop-in so the board is usable
    # when a cable is plugged in later.
    for _ in 1 2 3 4 5; do
        carrier=$(cat "/sys/class/net/${IFACE}/carrier" 2>/dev/null || echo 0)
        if [ "${carrier}" = "1" ]; then
            return 0
        fi
        sleep 1
    done
    log "no carrier on ${IFACE} after 5s; proceeding optimistically"
    return 0
}

ip_is_free() {
    # Returns 0 if the candidate appears unused on the segment.
    # arping -D sends a Duplicate Address Detection probe:
    #   -D = DAD mode (exit 0 if free, 1 if conflict)
    #   -q = quiet
    #   -c N = N probes
    #   -w S = timeout in seconds
    #   -I IFACE = source interface
    candidate="$1"
    if arping -D -q -c "${ARPING_PROBES}" -w "${ARPING_TIMEOUT}" \
              -I "${IFACE}" "${candidate}" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

dhcp_already_won() {
    # If systemd-networkd already gave us a lease (e.g. previous boot's
    # configuration is still active because this is a re-run, not a fresh
    # boot), don't fight it.
    if ip -4 addr show dev "${IFACE}" 2>/dev/null \
        | grep -q "inet .* dynamic"; then
        return 0
    fi
    return 1
}

# ---- main -----------------------------------------------------------------

mkdir -p "${STATE_DIR}"

if ! command -v arping >/dev/null 2>&1; then
    log "arping not found; falling back to 192.168.2.99 unconditionally"
    write_dropin "${SUBNET_PREFIX}.99"
    print_console "${SUBNET_PREFIX}.99 (no-arping fallback)"
    write_motd "${SUBNET_PREFIX}.99"
    exit 0
fi

bring_iface_up

if dhcp_already_won; then
    log "DHCP lease detected on ${IFACE}; skipping static auto-IP"
    exit 0
fi

# Build the try-order: sticky IP first (if any), then default 99, then rest.
TRY_ORDER=""
if [ -r "${STATE_FILE}" ]; then
    sticky=$(cat "${STATE_FILE}" 2>/dev/null | tr -dc '0-9.')
    case "${sticky}" in
        "${SUBNET_PREFIX}."*)
            TRY_ORDER="${sticky}"
            log "sticky IP from previous boot: ${sticky}"
            ;;
        *)
            log "stale/invalid state file (${sticky:-empty}); ignoring"
            ;;
    esac
fi
for last_octet in ${CANDIDATES}; do
    candidate="${SUBNET_PREFIX}.${last_octet}"
    case " ${TRY_ORDER} " in
        *" ${candidate} "*) ;;        # already in list (sticky)
        *) TRY_ORDER="${TRY_ORDER} ${candidate}" ;;
    esac
done

chosen=""
for candidate in ${TRY_ORDER}; do
    log "probing ${candidate} via arping -D"
    if ip_is_free "${candidate}"; then
        chosen="${candidate}"
        log "claimed ${chosen}"
        break
    else
        log "${candidate} is in use, trying next"
    fi
done

if [ -z "${chosen}" ]; then
    log "ALL candidates in 192.168.2.99-110 are taken; leaving eth0 to DHCP only"
    # Don't write a drop-in. The shipped 10-eth0.network will still request
    # DHCP; the static .99 in it will likely fail to bind cleanly, but the
    # alternative (silently squatting on someone else's IP) is worse.
    print_console "AUTO-IP FAILED (all candidates taken) -- DHCP only"
    exit 0
fi

write_dropin "${chosen}"
echo "${chosen}" >"${STATE_FILE}"
chmod 0644 "${STATE_FILE}"
print_console "${chosen}"
write_motd "${chosen}"

exit 0
